<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- 仅在此添加范围明确、原因充分的历史代码例外，禁止使用全局宽泛排除。 -->
    <!-- Eclipse JDT owns indentation; running a second indentation engine creates conflicting output. -->
    <suppress checks="Indentation" files=".*[.]java"/>
    <!-- Existing public APIs predate Checkstyle. New and changed APIs must add Javadoc per AGENTS.md. -->
    <suppress checks="JavadocParagraph|MissingJavadocType|MissingJavadocMethod" files=".*[.]java"/>
    <!-- The security compatibility layer intentionally preserves its published API and control-flow source shape. -->
    <suppress
        checks="AvoidStarImport|CustomImportOrder|EmptyCatchBlock|LineLength|MultipleVariableDeclarations|NeedBraces|RequireEmptyLineBeforeBlockTagGroup|VariableDeclarationUsageDistance"
        files=".*pm-pf4j-security.*/src/main/java/.*[.]java"/>
    <suppress checks="LineLength"
        files=".*DefaultPluginAnonymousPathRegistry[.]java"/>
    <!-- Preserve the mechanically migrated runtime repository control-flow source shape. -->
    <suppress checks="NeedBraces"
        files=".*PmJarPluginRepository[.]java"/>
    <!-- The WebFlux routing DSL preserves Spring's uppercase HTTP method API and mechanically migrated source shape. -->
    <suppress
        checks="AbbreviationAsWordInName|AvoidStarImport|CustomImportOrder|MethodName|NeedBraces"
        files=".*pm-pf4j-web/src/main/java/com/pmplugin4j/webflux/(PmRouterFunctions|PmPluginWebFluxDefaultRouterFunctionRegistry|PmPluginWebFluxRequestMappingHandlerMapping|PmPluginWebFluxRouterFunctionRegistry)[.]java"/>
</suppressions>
