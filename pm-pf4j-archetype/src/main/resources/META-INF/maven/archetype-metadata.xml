<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0" name="pm-pf4j-plugin">
    <requiredProperties>
        <requiredProperty key="pmSpringPf4jVersion">
            <defaultValue>0.1.0-alpha.1</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" packaged="true">
            <directory>src/main/java</directory>
            <includes><include>**/*.java</include></includes>
        </fileSet>
        <fileSet filtered="true" packaged="false">
            <directory>src/main/resources</directory>
            <includes><include>plugin.properties</include></includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
